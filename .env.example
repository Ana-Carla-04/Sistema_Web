# ==============================================
# BACKEND / DOCKER COMPOSE
# ==============================================
# Credenciais do PostgreSQL usadas pelo docker-compose.
POSTGRES_DB=sipa
POSTGRES_USER=sipa
POSTGRES_PASSWORD=troque-esta-senha

# Segredo forte usado para assinar os tokens JWT.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ==============================================
# FRONTEND (Vite le este arquivo da raiz via envDir em vite.config.js)
# ==============================================
# Base das rotas da API. Mantenha "/SIPA" para usar o proxy (Vite em dev, Nginx no Docker).
VITE_API_BASE_URL=/SIPA

# Alvo do proxy de desenvolvimento do Vite (npm run dev).
VITE_DEV_PROXY_TARGET=http://localhost:8080
