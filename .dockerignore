# .dockerignore unico (o contexto de build e a raiz para backend e frontend)

# Artefatos gerados localmente
target/
frontend/node_modules/
frontend/dist/
.git/
.gitignore

# Variaveis de ambiente locais (nunca vao para a imagem)
.env
frontend/.env
frontend/.env.local

# Metadados e configuracoes locais do editor
.vscode/
.idea/
.github/
*.iml

# Logs e arquivos temporarios
*.log
*.tmp

# Documentacao que nao e necessaria para a imagem
HELP.md
*.md
